<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:letterSpacing">0.009375</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.ButtonSmall" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">15sp</item>
        <item name="android:letterSpacing">0.0333333</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.0333333</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:letterSpacing">0.0333333</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/auth_button_height</item>
        <item name="android:layout_height">@dimen/auth_button_height</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/auth_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/auth_button_padding_horizontal</item>

        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/accent_primary</item>

        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconPadding">@dimen/auth_button_content_gap</item>
    </style>

    <style name="AppButtonSocialIcon">
        <item name="android:layout_height">@dimen/social_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Widget.App.Button.Social" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/social_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.App.EditText.Auth" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">@dimen/auth_input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/auth_input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/auth_input_padding_horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textAppearance">@style/TextAppearance.App.BodyMedium</item>
    </style>

    <style name="AppTextViewTopBarTitle">
        <item name="android:textAppearance">@style/TextAppearance.App.Headline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppTextViewInputLabel">
        <item name="android:textAppearance">@style/TextAppearance.App.TitleMedium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>



</resources>