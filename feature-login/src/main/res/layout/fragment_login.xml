<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <TextView
        android:id="@+id/titleTextView"
        style="@style/Widget.App.TextView.TopBarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:text="Вход"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/emailLabelTextView"
        style="@style/Widget.App.TextView.InputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_title_to_fields"
        android:text="Email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTextView" />

    <EditText
        android:id="@+id/emailEditText"
        style="@style/Widget.App.EditText.Auth"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_input_height"
        android:layout_marginTop="@dimen/space_8"
        android:hint="example@gmail.com"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailLabelTextView" />

    <TextView
        android:id="@+id/passwordLabelTextView"
        style="@style/Widget.App.TextView.InputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_group_gap"
        android:text="Пароль"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailEditText" />

    <EditText
        android:id="@+id/passwordEditText"
        style="@style/Widget.App.EditText.Auth"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_input_height"
        android:layout_marginTop="@dimen/space_8"
        android:hint="Введите пароль"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordLabelTextView" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginButton"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginTop="@dimen/auth_fields_to_submit"
        android:enabled="false"
        android:text="Вход"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordEditText" />

    <LinearLayout
        android:id="@+id/registrationRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginButton">

        <TextView
            android:id="@+id/noAccountTextView"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Нету аккаунта?" />

        <TextView
            android:id="@+id/registrationTextView"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:clickable="false"
            android:enabled="false"
            android:text="Регистрация"
            android:textColor="@color/accent_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/forgotPasswordTextView"
        style="@style/TextAppearance.App.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:clickable="false"
        android:enabled="false"
        android:text="Забыл пароль"
        android:textColor="@color/accent_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/registrationRow" />

    <View
        android:id="@+id/dividerView"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_thin"
        android:layout_marginTop="@dimen/space_32"
        android:background="@drawable/bg_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forgotPasswordTextView" />

    <LinearLayout
        android:id="@+id/socialButtonsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:layout_marginBottom="94dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerView">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/vkButton"
            style="@style/Widget.App.Button.SocialIcon"
            android:layout_width="0dp"
            android:layout_height="@dimen/social_button_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:background="@drawable/bg_button_vk"
            android:contentDescription="VK"
            app:srcCompat="@drawable/logo_vk" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/okButton"
            style="@style/Widget.App.Button.SocialIcon"
            android:layout_width="0dp"
            android:layout_height="@dimen/social_button_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/bg_button_ok"
            android:contentDescription="OK"
            app:srcCompat="@drawable/logo_ok" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>